# Optional Groq API key. Server only; never add a VITE_ prefix.
GROQ_API_KEY=your_groq_api_key
# Optional model override. Defaults to Groq's GPT-OSS 20B JSON Schema model.
GROQ_MODEL=openai/gpt-oss-20b
# Optional ElevenLabs key for spoken simulation alerts. Server only; never add a VITE_ prefix.
# Without it, alerts use a short tone and the browser's built-in voice.
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Optional voice id override. Leave empty for the default voice.
ELEVENLABS_VOICE_ID=
